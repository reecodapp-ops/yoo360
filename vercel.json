{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/design-orders/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/design-orders/:path*",
      "destination": "https://yoo360-studio-orders.berton-thedezi.chatgpt.site/api/:path*"
    }
  ]
}
