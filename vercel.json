{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/design-orders/:path*",
      "destination": "https://yoo360-studio-orders.berton-thedezi.chatgpt.site/api/:path*"
    },
    {
      "source": "/order-a-design/payment-status/:id",
      "destination": "/order-a-design/payment-status"
    },
    {
      "source": "/order-a-design/project-brief/:id",
      "destination": "/order-a-design/project-brief"
    },
    {
      "source": "/order-a-design/order/:id([0-9a-f-]{36})",
      "destination": "/order-a-design/order"
    }
  ],
  "headers": [
    {
      "source": "/api/design-orders/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/order-a-design/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/order-a-design/:path(checkout|payment-status|project-brief|order)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/campaigns-market-launches",
      "destination": "/marketing-partnerships",
      "permanent": true
    },
    {
      "source": "/brand-strategy-identity",
      "destination": "/order-a-design/order/logo",
      "permanent": true
    }
  ]
}
